{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Launch with tsx",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "development",
                "DEBUG": "wa_reminders:*"
            },
            "runtimeExecutable": "node",
            "args": [
                "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
                "${relativeFile}"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "<node_modules>/**"
            ],
            "type": "node"
        },
        {
            "name": "Dry Run (development)",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "development"
            },
            "runtimeExecutable": "node",
            "args": [
                "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
                "${workspaceFolder}/src/index.ts",
                "--dry-run"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "<node_modules>/**"
            ],
            "type": "node"
        },
        {
            "name": "Dry Run (production)",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "production"
            },
            "runtimeExecutable": "node",
            "args": [
                "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
                "${workspaceFolder}/src/index.ts",
                "--dry-run",
                "--env=production"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "<node_modules>/**"
            ],
            "type": "node"
        },
        {
            "name": "Vitest Tests",
            "args": [
                "run"
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Launch Program",
            "env": {
                "NODE_ENV": "development"
            },
            "program": "${workspaceFolder}/dist/index.js",
            "outFiles": [
                "${workspaceFolder}/dist/**/*",
                "!**/node_modules/**"
            ],
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Attach to Node Functions",
            "type": "node",
            "request": "attach",
            "restart": true,
            "port": 9229,
            "preLaunchTask": "func: host start"
        }
    ]
}