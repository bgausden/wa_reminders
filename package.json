{
  "name": "wa_reminders",
  "version": "0.0.1",
  "description": "Automated Whatsapp reminders for MBO",
  "type": "module",
  "main": "dist/azureFunctionApp.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-template.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "dry-run:prod": "tsx src/index.ts --dry-run --env=production",
    "start:azure": "func start --port 7071",
    "deploy:azure:local": "pwsh -NoProfile -File ./scripts/deploy-local.ps1",
    "provision:azure:egress": "pwsh -NoProfile -File ./scripts/provision-static-egress.ps1"
  },
  "author": "Barry Gausden",
  "license": "ISC",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.19.43",
    "mattpocock-skills": "^1.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@azure/functions": "^4.7.0",
    "@azure/storage-blob": "^12.33.0",
    "axios": "^1.20.0",
    "debug": "^4.4.3",
    "dotenv": "^16.6.1",
    "effect": "^3.22.2",
    "ejs": "^3.1.10",
    "fixed-width-string": "^2.0.0",
    "support-color": "^7.1.0"
  }
}
